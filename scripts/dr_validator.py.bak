import uuid
import json
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


ENDPOINTS = {
    "primary": "http://172.198.68.165",
    "secondary": "http://20.235.89.90",
    "traffic_manager": "http://amaan-mrdr-2026.trafficmanager.net",
}

EXPECTED_CONTENT = {
    "primary": "PRIMARY REGION",
    "secondary": "SECONDARY REGION",
    "traffic_manager": None,
}


REPORT_DIR = Path(__file__).resolve().parent.parent / "reports"


def check_endpoint(name, url):
    started = time.perf_counter()

    try:
        request = urllib.request.Request(
            url,
            headers={"User-Agent": "DR-Validator/1.0"},
        )

        with urllib.request.urlopen(request, timeout=5) as response:
            body = response.read().decode("utf-8", errors="replace")
            latency_ms = round((time.perf_counter() - started) * 1000, 2)

            return {
                "endpoint": name,
                "url": url,
                "healthy": (
                    response.status == 200
                    and (
                        EXPECTED_CONTENT[name] is None
                        or EXPECTED_CONTENT[name] in body
                    )
                ),
                "status_code": response.status,
                "latency_ms": latency_ms,
                "checked_at": datetime.now(timezone.utc).isoformat(),
                "error": None,
            }

    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return {
            "endpoint": name,
            "url": url,
            "healthy": False,
            "status_code": None,
            "latency_ms": round((time.perf_counter() - started) * 1000, 2),
            "checked_at": datetime.now(timezone.utc).isoformat(),
            "error": str(exc),
        }


def measure_recovery(check_function, timeout_seconds=120, interval_seconds=2):
    started = time.perf_counter()
    deadline = started + timeout_seconds

    while time.perf_counter() < deadline:
        result = check_function()

        if result["healthy"]:
            return {
                "recovered": True,
                "rto_seconds": round(time.perf_counter() - started, 2),
                "result": result,
            }

        time.sleep(interval_seconds)

    return {
        "recovered": False,
        "rto_seconds": None,
        "result": None,
    }

def test_rto_measurement():
    simulated_start = time.perf_counter()

    def simulated_recovery_check():
        elapsed = time.perf_counter() - simulated_start

        return {
            "healthy": elapsed >= 4,
            "status_code": 200 if elapsed >= 4 else None,
        }

    return measure_recovery(
        simulated_recovery_check,
        timeout_seconds=10,
        interval_seconds=1,
    )

def main():
    results = [
        check_endpoint(name, url)
        for name, url in ENDPOINTS.items()
    ]
    test_id = str(uuid.uuid4())
    report = {
        "project": "multi-region-disaster-recovery",
        "test_id": test_id,
        "test_type": "endpoint_health_check",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "results": results,
    }
    healthy_count = sum(result["healthy"] for result in results)
    total_count = len(results)

    report["summary"] = {
        "total_endpoints": total_count,
        "healthy_endpoints": healthy_count,
        "unhealthy_endpoints": total_count - healthy_count,
        "overall_status": (
            "READY" if healthy_count == total_count else "DEGRADED"
        ),
    }
    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    report_path = REPORT_DIR / "latest-report.json"
    report_path.write_text(json.dumps(report, indent=2), encoding="utf-8")

    for result in results:
        status = "HEALTHY" if result["healthy"] else "UNHEALTHY"
        print(
            f'{result["endpoint"].upper()}: {status} '
            f'| latency={result["latency_ms"]} ms'
        )
    print(
        f"\nDR STATUS: {report['summary']['overall_status']} "
        f"({healthy_count}/{total_count} endpoints healthy)"
    )
    print(f"\nReport saved to: {report_path}")
    rto_test = test_rto_measurement()
    report["rto_test"] = {
        "test_type": "simulated_recovery",
        "recovered": rto_test["recovered"],
        "rto_seconds": rto_test["rto_seconds"],
    }

    report_path.write_text(
        json.dumps(report, indent=2),
        encoding="utf-8",
    )

    print(f"RTO test recovered: {rto_test['recovered']}")
    print(f"Measured RTO: {rto_test['rto_seconds']} seconds")
    print(f"Updated report: {report_path}")
    
    history_path = REPORT_DIR / "dr-history.jsonl"

    with history_path.open("a", encoding="utf-8") as history_file:
        history_file.write(json.dumps(report) + "\n")

    print(f"History saved to: {history_path}")

if __name__ == "__main__":
    main()
